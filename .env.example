# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="https://superlocucao.inforartes.com.br"

# ELEVENLABS_API_KEY: Optional ElevenLabs API key for ultra-high fidelity TTS.
ELEVENLABS_API_KEY="YOUR_ELEVENLABS_API_KEY"

# ELEVENLABS_DEFAULT_VOICE_ID: Optional default voice ID for ElevenLabs
ELEVENLABS_DEFAULT_VOICE_ID="OlxPtqeyGl5zwd5zVlKX"

# PORT
PORT=3000
NODE_ENV="production"
