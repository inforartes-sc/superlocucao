# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="https://superlocucao.inforartes.com.br"

# ELEVENLABS_API_KEY: Optional ElevenLabs API key for ultra-high fidelity TTS.
ELEVENLABS_API_KEY="YOUR_ELEVENLABS_API_KEY"

# ELEVENLABS_DEFAULT_VOICE_ID: Optional default voice ID for ElevenLabs
ELEVENLABS_DEFAULT_VOICE_ID="OlxPtqeyGl5zwd5zVlKX"

# PORT
PORT=3000
NODE_ENV="production"

# DATABASE_URL: PostgreSQL da VPS para persistência segura
# DATABASE_URL="postgresql://usuario:senha@localhost:5432/superlocucao"

# MERCADO PAGO GATEWAY (Opcional se configurado no Super Admin; garante persistência permanente contra qualquer reset)
MERCADOPAGO_ACCESS_TOKEN="APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
MERCADOPAGO_PUBLIC_KEY="APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MERCADOPAGO_MODE="production"
MERCADOPAGO_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxx"
